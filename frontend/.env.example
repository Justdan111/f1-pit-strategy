# WebSocket origin for the backend. Defaults to ws://127.0.0.1:8000 when unset.
# Day 5 (deployment) will need this pointed at the deployed backend, and will
# need wss:// rather than ws:// — a page served over https cannot open an
# insecure WebSocket.
NEXT_PUBLIC_BACKEND_WS_URL=ws://127.0.0.1:8000
