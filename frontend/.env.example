# Backend URL. Accepts https://, http://, wss://, ws:// or a bare host — the
# scheme is normalised, so an https:// URL becomes wss:// automatically.
# Unset, the app falls back to http://127.0.0.1:8000 only when the page itself
# is served from localhost.
NEXT_PUBLIC_BACKEND_WS_URL=https://f1-pit-strategy.onrender.com

# API key, if the backend requires one (F1_API_KEYS set on the server).
# Sent as a WebSocket subprotocol, not a query parameter, so it does not reach
# the server's access log.
#
# NOT A SECRET: anything prefixed NEXT_PUBLIC_ is compiled into the browser
# bundle and readable by anyone who opens devtools. It deters casual abuse of
# a rate-limited backend and can be rotated; it does not authenticate users.
# NEXT_PUBLIC_API_KEY=
